{
  "file_scan_exclusions": ["*.git", "*.DS_Store"],
  "features": {
    "edit_prediction_provider": "none"
  },
  "show_completions_on_input": true,
  "outline_panel": {
    "button": false
  },
  "collaboration_panel": {
    "button": false
  },
  "notification_panel": {
    "button": false
  },
  "icon_theme": "Catppuccin Latte",
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true,
    "use_system_clipboard": "never"
  },
  "extend_comment_on_newline": false,
  "diagnostics": {
    "include_warnings": true,
    "inline": {
      "enabled": true,
      "update_debounce_ms": 150,
      "padding": 4,
      "min_column": 0,
      "max_severity": null
    }
  },
  "vertical_scroll_margin": 8,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 16,
  "buffer_font_size": 16,
  "base_keymap": null,
  "cursor_blink": false,
  "autosave": "on_focus_change",
  "format_on_save": "off",
  "tab_bar": {
    "show": true
  },
  "indent_guides": {
    "enabled": true
  },
  "inlay_hints": {
    "enabled": false
  },
  "scrollbar": {
    "show": "never"
  },
  "buffer_line_height": {
    "custom": 1.5
  },
  "terminal": {
    "dock": "bottom",
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 15,
    "line_height": {
      "custom": 1.5
    }
  },
  "theme": {
    "mode": "system",
    "light": "Gruvbox Dark Hard",
    "dark": "One Dark"
  },
  "experimental.theme_overrides": {
    "players": [
      {
        "cursor": "#FB4934",
        "background": "#8d3250ff",
        "selection": "#8d32503d"
      }
    ]
  },
  "assistant": {
    "button": false,
    "dock": "left",
    "default_model": {
      "provider": "copilot_chat",
      "model": "gpt-4o"
    },
    "version": "2"
  },
  "tabs": {
    "close_position": "right",
    "file_icons": true,
    "git_status": true,
    "activate_on_close": "left_neighbour",
    "show_close_button": "hover"
  },
  "telemetry": {
    // Send debug info like crash reports.
    "diagnostics": false,
    // Send anonymized usage data like what languages you're using Zed with.
    "metrics": false
  },
  "git": {
    "git_gutter": "tracked_files",
    "inline_blame": {
      "enabled": true,
      "position": "right"
    }
  }
}
